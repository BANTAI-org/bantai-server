  "info": {
    "title": "Bantai Command Center API",
    "description": "API Contract for Bantai Command Center API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "Authorization",
        "description": "Enter JWT access token",
        "in": "header"
      }
    },
    "schemas": {
      "CreateCommandCenterDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Command center name",
            "example": "Central District Command Center"
          },
          "type": {
            "type": "string",
            "enum": [
              "barangay",
              "police_station",
              "mdrrmo"
            ],
            "description": "Type of the command center",
            "example": "barangay"
          },
          "branch": {
            "type": "string",
            "description": "Command center branch name",
            "example": "Central District"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "latitude": {
                "type": "number",
                "description": "Latitude in decimal degrees",
                "example": 14.676
              },
              "longitude": {
                "type": "number",
                "description": "Longitude in decimal degrees",
                "example": 121.0437
              }
            },
            "required": [
              "latitude",
              "longitude"
            ],
            "description": "Command center geographic coordinates",
            "example": {
              "latitude": 14.676,
              "longitude": 121.0437
            }
          }
        },
        "required": [
          "name",
          "type",
          "branch"
        ]
      },
      "UpdateCommandCenterDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Command center name",
            "example": "Central District Command Center"
          },
          "type": {
            "type": "string",
            "enum": [
              "barangay",
              "police_station",
              "mdrrmo"
            ],
            "description": "Type of the command center",
            "example": "barangay"
          },
          "branch": {
            "type": "string",
            "description": "Command center branch name",
            "example": "Central District"
          },
          "location": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "latitude": {
                "type": "number",
                "description": "Latitude in decimal degrees",
                "example": 14.676
              },
              "longitude": {
                "type": "number",
                "description": "Longitude in decimal degrees",
                "example": 121.0437
              }
            },
            "description": "Command center geographic coordinates",
            "example": {
              "latitude": 14.676,
              "longitude": 121.0437
            }
          }
        }
      },
      "UpdateResponderEmailDTO": {
