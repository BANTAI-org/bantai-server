    "/command-centers/{centerId}/responders/filter": {
      "get": {
        "description": "All filters compose with AND. Multi-value filters are accepted as repeated params (`?status=active&status=deactivated`) or comma-separated (`?status=active,deactivated`). Date-only values are anchored to UTC days. Soft-deleted (deactivated) responders are excluded unless `includeSoftDeleted=true`.",
        "operationId": "CommandCenterController_filterResponders",
        "parameters": [
          {
            "name": "centerId",
            "required": true,
            "in": "path",
            "description": "Command center UUID",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Match any of these account statuses",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pending_activation",
                  "active",
                  "deactivated"
                ]
              }
            }
          },
          {
            "name": "availability",
            "required": false,
            "in": "query",
            "description": "Match any of these availability states",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "on_duty",
                  "off_duty",
                  "dispatched",
                  "en_route"
                ]
              }
            }
          },
          {
            "name": "agency",
            "required": false,
            "in": "query",
            "description": "Match any of these agencies",
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "police",
                  "barangay_tanod",
                  "mdrrmo"
                ]
              }
            }
          },
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Substring match (case-insensitive) over name and email",
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "name": "createdFrom",
            "required": false,
            "in": "query",
            "description": "Inclusive lower bound on user_account.created_at. ISO 8601; date-only means 00:00:00.000Z of that day.",
            "schema": {
              "example": "2026-09-01",
              "type": "string"
            }
          },
          {
            "name": "createdTo",
            "required": false,
            "in": "query",
            "description": "Inclusive upper bound on user_account.created_at. ISO 8601; date-only means 23:59:59.999Z of that day.",
            "schema": {
              "example": "2026-10-23",
              "type": "string"
            }
          },
          {
            "name": "updatedFrom",
            "required": false,
            "in": "query",
            "description": "Inclusive lower bound on updated_at",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "updatedTo",
            "required": false,
            "in": "query",
            "description": "Inclusive upper bound on updated_at",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastActiveFrom",
            "required": false,
            "in": "query",
            "description": "Inclusive lower bound on r_profile.last_active_at",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lastActiveTo",
            "required": false,
            "in": "query",
            "description": "Inclusive upper bound on r_profile.last_active_at",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "onShift",
            "required": false,
            "in": "query",
            "description": "true → currently on duty with a non-expired shift_ends_at; false → the inverse (includes off-duty and expired shifts)",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "includeSoftDeleted",
            "required": false,
            "in": "query",
            "description": "When true, include soft-deleted (deactivated) responders. Combine with status=deactivated to find accounts to reactivate.",
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "type": "number"
            }
          },
          {
            "name": "cursor",
            "required": false,
            "in": "query",
            "description": "Opaque cursor from the previous page",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Responder page returned"
          },
          "400": {
            "description": "Invalid filter parameters"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Not your command center"
          }
        },
        "security": [
          {
            "access-token": []
          }
        ],
        "summary": "Filter responders in a command center",
        "tags": [
          "Command Centers"
        ],
        "x-roles": [
          "super",
          "admin"
        ]
      }
    },
